# --- Khet-Setu Environment Variables ---

# 1. Secret Key for Flask sessions (can be any random string locally)
FLASK_SECRET_KEY=your-local-secret-key-123

# 2. Supabase / PostgreSQL Database URL 
# Replace this with your actual Supabase connection string for production.
# Example: postgresql://postgres:yourpassword@db.supabase.co:5432/postgres
# If this is left blank or commented out, the app defaults to local SQLite.
# DATABASE_URL=

# 3. Weather API Keys
WEATHERAPI_KEY=your-primary-weather-api-key
WEATHERAPI_KEY_FALLBACK=your-fallback-weather-api-key
